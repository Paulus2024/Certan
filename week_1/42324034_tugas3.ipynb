   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "9dfe5119",
   "metadata": {},
   "outputs": [],
   "source": [
    "x = np.linspace(-3, 3, 100)\n",
    "y = np.linspace(-3, 3, 100)\n",
    "X, Y = np.meshgrid(x, y)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "9939b776",
   "metadata": {},
   "outputs": [],
   "source": [
    "Z = (5 * Y / 4 - np.abs(X)) ** 2 + X**2"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "54fa67c6",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 640x480 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "plt.axes(projection=\"3d\").plot_surface(X, Y, Z)\n",
    "plt.show()"
   ]
  }
 ],
